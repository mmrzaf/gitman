# Copy to .env and fill in the required password and absolute data path.
GITMAN_IMAGE=gitman:local
# Generate a URL-safe value with: openssl rand -hex 24
GITMAN_DATABASE_PASSWORD=
GITMAN_DATABASE_PORT=5433
GITMAN_DATA_DIR=/srv/gitman

# Standalone HTTP listens only on the host's loopback interface.
GITMAN_PUBLIC_URL=http://localhost:8080
GITMAN_BIND_ADDRESS=127.0.0.1
GITMAN_HTTP_PORT=8080
# Required only for compose.production.yaml (public HTTPS).
GITMAN_DOMAIN=git.example.com

# Optional secret encryption: openssl rand -base64 32
# Keep a protected separate backup of this key.
GITMAN_SECRET_KEY=

# Only trust the actual reverse proxy addresses/CIDRs, if configured.
GITMAN_TRUSTED_PROXIES=
GITMAN_LOG_RETENTION_DAYS=30
GITMAN_RUN_RETENTION_DAYS=90
GITMAN_AUDIT_RETENTION_DAYS=365
GITMAN_DEPLOYMENT_RETENTION_DAYS=365
GITMAN_DATABASE_MAX_CONNS=0
GITMAN_LOG_LEVEL=info
GITMAN_LOG_FORMAT=text

# Host resource profile. Socket-created child containers need their own limits.
GITMAN_STEP_MEMORY_MIB=2048
GITMAN_STEP_CPUS=2
GITMAN_STEP_PIDS=256
GITMAN_WORKSPACE_GIB=10
GITMAN_DISK_RESERVE_GIB=5
