# Copy to .env and fill in. See README.md for what each setting does.

# The host name Gitman is served at, through Traefik.
GITMAN_HOST=git.example.com

# PostgreSQL's password. It is part of a URL, so use URL-safe characters:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts repository secrets. At least 32 characters; leave empty to
# disable secrets. Changing it makes stored secrets unreadable.
#   openssl rand -base64 48
GITMAN_SECRET_KEY=

# Where repositories, hooks and run workspaces live on the host. Create it
# owned by uid 1000 before the first start:
#   sudo install -d -o 1000 -g 1000 /srv/gitman
GITMAN_DATA_DIR=/srv/gitman

# The address range Traefik reaches Gitman from, so client addresses in
# logs and the login limiter are the real ones. Docker's default networks
# fall inside 172.16.0.0/12.
GITMAN_TRUSTED_PROXIES=172.16.0.0/12

# Days to keep finished runs and their logs; 0 keeps them forever. Each
# ref's latest run and every deployment record are always kept.
GITMAN_RETENTION_DAYS=90

# Traefik: the external network it shares with Gitman, and the entry
# point and certificate resolver to use.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Images, to use a registry mirror.
POSTGRES_IMAGE=postgres:16-alpine
GITMAN_IMAGE=gitman:latest
