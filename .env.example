# Copy to .env next to compose.yaml and fill in. Every variable is
# described in docs/operator/configuration.md.

# The image to run.
GITMAN_IMAGE=gitman:1.0.0-beta.22

# The host name Traefik routes to Gitman; Gitman is served at
# https://<GITMAN_DOMAIN>.
GITMAN_DOMAIN=git.example.com

# The PostgreSQL on the "data" network. The password is part of a URL, so
# use URL-safe characters: openssl rand -hex 24
GITMAN_DATABASE_URL=postgres://gitman:password@postgres:5432/gitman?sslmode=disable

# Encrypts repository secrets. At least 32 characters; leave empty to
# disable secrets. Changing it makes stored secrets unreadable.
#   openssl rand -base64 48
GITMAN_SECRET_KEY=

# Where repositories, hooks and run workspaces live on the host. Create it
# owned by uid 1000 before the first start:
#   sudo install -d -o 1000 -g 1000 /srv/apps/gitman/data
GITMAN_DATA_DIR=/srv/apps/gitman/data

# Every proxy between the client and Gitman, so client addresses in logs
# and the sign-in limiter are the real ones: Traefik, inside Docker's
# 172.16.0.0/12, and ArvanCloud's published ranges, comma-separated
# (https://www.arvancloud.ir/en/ips.txt).
GITMAN_TRUSTED_PROXIES=172.16.0.0/12

# Days to keep finished runs and their logs; 0 keeps them forever. Each
# ref's latest run and every deployment record are always kept.
GITMAN_RETENTION_DAYS=90

# Caps web and worker's own connection pool sizes; 0 keeps each process's
# own default.
GITMAN_DATABASE_MAX_CONNS=0

# debug, info, warn or error; text or json.
GITMAN_LOG_LEVEL=info
GITMAN_LOG_FORMAT=text
